rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check - Hardcoded email for immediate access
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'khunthanshwe@gmail.com';
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Schools
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Contacts
    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Messages (Nested in Rooms)
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId);
    }

    // Gallery
    match /gallery/{galleryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Associations & Committee members
    match /associations/{associationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
