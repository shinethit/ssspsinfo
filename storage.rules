rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
