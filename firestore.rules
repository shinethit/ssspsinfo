rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }

    // The caller's admins doc, resolved by uid first, then by email.
    // Returns {} when signed out or when no admins doc exists.
    // Legacy roles are normalized here: super_admin counts as admin,
    // editor / sports_moderator / news_editor count as moderator.
    function adminDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data
        : (isSignedIn() && request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
            ? get(/databases/$(database)/documents/admins/$(request.auth.token.email)).data
            : {});
    }

    // Any admins doc (admin or moderator, including legacy roles).
    function isModerator() {
      return isSignedIn() && adminDoc().role in ['moderator', 'admin', 'super_admin', 'editor', 'sports_moderator', 'news_editor'];
    }

    // Admin only (legacy super_admin counts as admin).
    function isAdmin() {
      return isSignedIn() && adminDoc().role in ['admin', 'super_admin'];
    }

    match /{document=**} { allow read, write: if false; }

    // Public content — anyone can read; moderators and admins can write
    // Schools: the owning school may update only its own contact info
    match /schools/{id} {
      allow read: if true;
      allow create, delete: if isModerator();
      // v24.15 (P2): legacy "adopt" — a signed-in user whose Auth email
      // matches the school doc's accountEmail may set the doc's authUid to
      // their own uid ONCE, when the doc has no authUid yet, updating only
      // authUid + updatedAt. Legacy email-only accounts can log in but
      // cannot save anything until adopted; after adoption the owner-update
      // and events rules above work for them. NOTE: this rule must be
      // published in Firebase Console after deploy, or adoption is denied
      // and the portal stays read-only for those schools.
      allow update: if isModerator()
        || (isSignedIn() && resource.data.authUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolPhone', 'address', 'township', 'zone', 'studentCount', 'updatedAt']))
        || (isSignedIn()
            // v24.15 re-audit (R4): '' counts as missing too — a doc that
            // ever carries an empty-string authUid would otherwise be
            // attempted (and denied) on EVERY portal load.
            && (resource.data.get('authUid', null) == null || resource.data.get('authUid', null) == '')
            && request.auth.token.email != null
            && resource.data.accountEmail == request.auth.token.email
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authUid', 'updatedAt'])
            && request.resource.data.authUid == request.auth.uid);
    }
    match /announcements/{id}  { allow read: if true; allow write: if isModerator(); }
    match /tickers/{id}        { allow read: if true; allow write: if isModerator(); }
    match /gallery/{id}        { allow read: if true; allow write: if isModerator(); }
    match /associations/{id}   { allow read: if true; allow write: if isModerator(); }
    match /school_levels/{id}  { allow read: if true; allow write: if isModerator(); }
    match /events/{id} {
      allow read: if true;
      allow create: if isModerator() || (isSignedIn() && request.resource.data.schoolId is string && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.authUid == request.auth.uid);
      allow update, delete: if isModerator() || (isSignedIn() && resource.data.schoolId is string && get(/databases/$(database)/documents/schools/$(resource.data.schoolId)).data.authUid == request.auth.uid);
    }
    match /sports_events/{id}  { allow read: if true; allow write: if isModerator(); }
    match /sport_info/{id}     { allow read: if true; allow write: if isModerator(); }
    match /athletes/{id}       { allow read: if true; allow write: if isModerator(); }
    match /documents/{id}      { allow read: if true; allow write: if isModerator(); }

    // Contacts are public — anyone can see them to get in touch; only moderators/admins can write
    match /contacts/{id}       { allow read: if true; allow write: if isModerator(); }

    // Transactions — public receipt links need single-doc reads; listing/writing is moderator/admin-only
    match /transactions/{id} {
      allow get: if true;
      allow list, create, update, delete: if isModerator();
    }

    // Event registrations — anyone can register (validated), only moderators/admins manage
    match /event_registrations/{id} {
      allow create: if request.resource.data.eventId is string
        && request.resource.data.schoolName is string
        && request.resource.data.contactPhone is string
        && request.resource.data.attendeesCount is number
        && request.resource.data.attendeesCount >= 1
        && request.resource.data.attendeesCount <= 200;
      allow read, update, delete: if isModerator();
    }

    // School update requests — signed-in schools can submit, only moderators/admins manage
    match /school_update_requests/{id} {
      allow create: if isSignedIn();
      // v24.7: a school can read its own requests (to see pending /
      // approved / rejected) — moderators and admins still read all.
      allow read: if isModerator() || (isSignedIn() && resource.data.requestedByUid == request.auth.uid);
      allow update, delete: if isModerator();
    }

    match /messages/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow update: if false;
      allow delete: if isModerator();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /admins/{id} {
      // Read unchanged: self, or any moderator/admin (was isAdmin() when that meant any admins doc)
      allow read: if isSignedIn() && (
        request.auth.uid == id ||
        (request.auth.token.email != null && request.auth.token.email == id) ||
        isModerator()
      );
      allow write: if isAdmin();
    }
  }
}
