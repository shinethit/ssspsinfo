rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Schools (Public read for member directory, write for admin management)
    match /schools/{schoolId} {
      allow read, write: if true;
    }

    // Contacts
    match /contacts/{contactId} {
      allow read, write: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Tickers (Marquee / Running Announcement Bar)
    match /tickers/{tickerId} {
      allow read, write: if true;
    }

    // Messages & Chat Rooms
    match /messages/{messageId} {
      allow read, write: if true;
    }
    match /rooms/{roomId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Gallery
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Associations & Committee members
    match /associations/{associationId} {
      allow read, write: if true;
    }

    // School Levels (Customizable by Admin, read by all)
    match /school_levels/{levelId} {
      allow read, write: if true;
    }

    // Audit Logs (Track who performed which action and when)
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Admins Collection (Manage authorized admin profiles)
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Fallback for any newly created document in database
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
