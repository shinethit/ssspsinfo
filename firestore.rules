rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    // Admin check - Super Admin & Authorized Admins from admins collection
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'khunthanshwe@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email)))
      );
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Schools (Public read for member directory, write restricted to admins)
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contacts
    match /contacts/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Tickers (Marquee / Running Announcement Bar)
    match /tickers/{tickerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Messages (Nested in Rooms)
    match /rooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(roomId);
    }

    // Gallery
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Associations & Committee members
    match /associations/{associationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs (Track who performed which action and when)
    match /audit_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Admins Collection (Manage additional admins)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
