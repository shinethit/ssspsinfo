        "responsiblePerson2Role": { "type": "string" },
        "responsiblePerson2Phones": { "type": "array", "description": "Responsible Person 2 multiple phones", "items": { "type": "string" } },
        "founderPhones": { "type": "array", "description": "Founder multiple phones", "items": { "type": "string" } },
        "adminPhones": { "type": "array", "description": "Admin multiple phones", "items": { "type": "string" } },
