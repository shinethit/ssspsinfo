        "role": { "type": "string", "enum": ["super_admin", "admin", "editor"] },
        "phone": { "type": "string", "description": "Primary phone" },
        "phone2": { "type": "string" },
        "phones": { "type": "array", "description": "Multiple administrator contact numbers", "items": { "type": "string" } },
        "contactNumbers": { "type": "array", "description": "Multiple contact numbers", "items": { "type": "string" } },
